# Forex-only auto trader settings.
# Default is PAPER so it cannot place live broker orders until you explicitly enable MT5 live mode.

FOREX_BROKER=paper
FOREX_LIVE_TRADING_ENABLED=false
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD
# Optional for brokers that use suffixes, for example:
# FOREX_SYMBOL_MAP=EURUSD=EURUSD.a,USDCAD=USDCAD.a
FOREX_SYMBOL_MAP=
FOREX_TIMEFRAME=M5
FOREX_BARS=300
FOREX_POLL_SECONDS=60
FOREX_POSITION_CHECK_SECONDS=5

FOREX_STARTING_BALANCE=1000
FOREX_ACCOUNT_CURRENCY=USD
FOREX_RISK_PER_TRADE_PCT=0.005
FOREX_MAX_DAILY_LOSS_PCT=0.02
FOREX_DAILY_LOSS_COOLDOWN_MINUTES=30
FOREX_MAX_OPEN_POSITIONS=2
FOREX_MAX_POSITIONS_PER_SYMBOL=1
FOREX_MIN_LOT=0.01
FOREX_MAX_LOT=0.05
FOREX_PIP_VALUE_PER_STANDARD_LOT=10
FOREX_MAX_SPREAD_PIPS=2.0
FOREX_ENTRY_COST_GUARD_ENABLED=true
FOREX_MAX_ENTRY_COST_AMOUNT=0
FOREX_MAX_ENTRY_COST_TO_PROFIT_RATIO=0.40
FOREX_MIN_REWARD_SPREAD_MULTIPLE=3.0
FOREX_SLIPPAGE_GUARD_ENABLED=true
FOREX_MAX_SIGNAL_PRICE_DRIFT_PIPS=1.0
FOREX_EXPECTED_SLIPPAGE_PIPS=0.25
FOREX_MAX_SLIPPAGE_COST_AMOUNT=0
FOREX_MAX_SLIPPAGE_TO_PROFIT_RATIO=0.25

FOREX_MIN_CONFIDENCE=0.64
FOREX_MIN_SCORE=5
FOREX_MIN_SCORE_GAP=2
FOREX_AI_ENABLED=true
FOREX_AI_ALLOW_RULE_FALLBACK=false
FOREX_AI_MIN_TRAIN_ROWS=160
FOREX_AI_FORWARD_BARS=6
FOREX_AI_VALIDATION_SPLIT=0.25
FOREX_AI_MIN_VALIDATION_ACCURACY=0.52
FOREX_AI_MIN_VALIDATION_PRECISION=0.52
FOREX_AI_MIN_PROBABILITY=0.68
FOREX_AI_MIN_PROBABILITY_GAP=0.08
FOREX_AI_ALLOW_PROVISIONAL_MODELS=true
FOREX_AI_PROVISIONAL_MIN_PROBABILITY=0.78
FOREX_AI_PROVISIONAL_MIN_PROBABILITY_GAP=0.25
FOREX_AI_PROVISIONAL_MIN_VALIDATION_ACCURACY=0.45
FOREX_AI_PROVISIONAL_MIN_VALIDATION_PRECISION=0.35
FOREX_AI_MIN_MOVE_ATR=0.25
FOREX_AI_MIN_MOVE_PIPS=1.0
FOREX_AI_TRAINING_ITERATIONS=120
FOREX_AI_LEARNING_RATE=0.08
FOREX_AI_L2_REGULARIZATION=0.001
FOREX_ADAPTIVE_ENABLED=true
FOREX_ADAPTIVE_MIN_TRADES=20
FOREX_ADAPTIVE_LOOKBACK_TRADES=0
FOREX_ADAPTIVE_TARGET_WIN_RATE=0.55
FOREX_PROFESSIONAL_FILTERS_ENABLED=true
FOREX_ADX_PERIOD=14
FOREX_ADX_MIN_TREND=14
FOREX_BOLLINGER_PERIOD=20
FOREX_BOLLINGER_STD=2
FOREX_VWAP_WINDOW=48
FOREX_MAX_EXTENSION_ATR=2.8

FOREX_STOP_ATR_MULTIPLIER=1.8
FOREX_TAKE_PROFIT_RR=1.5
FOREX_TRAILING_ATR_MULTIPLIER=1.2
FOREX_BOT_MANAGED_EXITS=true
FOREX_EXIT_RECOVERY_ENABLED=true
FOREX_EXIT_RECOVERY_AFTER_SECONDS=300
FOREX_EXIT_RECOVERY_PROFIT_AMOUNT=0.01
FOREX_EXIT_REVERSAL_ENABLED=true
FOREX_EXIT_REVERSAL_CONFIDENCE=0.74
FOREX_EXIT_REVERSAL_MIN_SCORE=6
FOREX_EXIT_LOSS_ATR_MULTIPLIER=0.85
FOREX_EXIT_PROFIT_RR=1.20
FOREX_EXIT_PROFIT_AMOUNT=0
FOREX_EXIT_LOSS_AMOUNT=0
FOREX_EXIT_NEGATIVE_SMART_ENABLED=true
FOREX_EXIT_NEGATIVE_GRACE_SECONDS=900
FOREX_EXIT_NEGATIVE_MIN_LOSS_AMOUNT=0.25
FOREX_EXIT_NEGATIVE_MIN_IMPROVEMENT_AMOUNT=0.03

FOREX_LOG_PATH=logs/forex_trades.csv
FOREX_DB_PATH=data/forex_memory.sqlite3

# MetaTrader 5 live mode. Leave blank if your MT5 terminal is already logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC=260525
MT5_TIMEOUT_MS=60000
MT5_ORDER_DEVIATION_POINTS=10
MT5_STOP_BUFFER_POINTS=5
